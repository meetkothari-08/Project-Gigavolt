# Query-embedding service (vector/document server).
# Install: copy to /etc/systemd/system/, adjust paths/user, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now gigavolt-embedding-api
[Unit]
Description=Gigavolt query embedding API (intfloat/e5-small-v2)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/gigavolt
EnvironmentFile=/opt/gigavolt/.env
ExecStart=/opt/gigavolt/.venv/bin/python -m gigavolt.services.embedding_api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
