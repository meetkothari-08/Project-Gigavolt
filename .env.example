# Copy to .env and fill in. Never commit .env.

# --- MariaDB: Silver ERP schema (RAG retrieval + relational ingestion) -------
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=gigavolt_app
MARIADB_PASSWORD=
MARIADB_DATABASE=gigavolt

# --- MongoDB: BMS telemetry ---------------------------------------------------
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=sensorDB
MONGODB_COLLECTION=telemetry

# --- Vector search (vector/document server) ----------------------------------
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION=gigavolt_m4_final
EMBEDDING_API_URL=http://127.0.0.1:8001/embed

# --- LLM ------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi:latest
OLLAMA_TIMEOUT=180

# --- Filesystem (relative to the working directory) --------------------------
GIGAVOLT_DATA_DIR=data            # documents/, processed/, chroma_store/
GIGAVOLT_STATE_DIR=var/state      # SQLite checkpoint databases
GIGAVOLT_LOG_DIR=var/logs

# --- Document ingestion HTTP trigger -------------------------------------------
M6_API_KEY=

# --- MariaDB Vector prototype (04-vector-search/scripts/embed_to_mariadb.py) ---
VECTOR_DB_HOST=127.0.0.1
VECTOR_DB_USER=gigavolt_vector
VECTOR_DB_PASSWORD=
VECTOR_DB_DATABASE=gigavolt_vector_lab
